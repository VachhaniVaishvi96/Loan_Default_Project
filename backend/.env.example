# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# System Log Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Optional custom SQLite database location
# DATABASE_PATH=/tmp/loan_predictions.db
